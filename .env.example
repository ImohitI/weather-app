# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_key_here

# LLM providers — only the keys for providers you want to use are required

# console.anthropic.com (paid)
ANTHROPIC_API_KEY=your_anthropic_key_here

# platform.openai.com (paid)
OPENAI_API_KEY=your_openai_key_here

# aistudio.google.com (free tier, region-limited)
GEMINI_API_KEY=your_gemini_key_here

# console.groq.com (free)
GROQ_API_KEY=your_groq_key_here

# openrouter.ai (free models available)
OPENROUTER_API_KEY=your_openrouter_key_here

# huggingface.co/settings/tokens (free)
HUGGINGFACE_API_KEY=your_huggingface_key_here
